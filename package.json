{
  "name": "auto-batch-commit",
  "displayName": "Auto Batch Commit",
  "description": "Commit each changed file as its own commit with an auto-generated message, then sync with GitHub.",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sp-mujuni/auto-batch-commit.git"
  },
  "bin": {
    "auto-batch-commit": "./out/cli.js",
    "abc": "./out/cli.js"
  },
  "main": "./out/cli.js",
  "files": [
    "out",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "git",
    "commit",
    "auto-commit",
    "cli",
    "github",
    "per-file"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "tsc -p . --noEmit",
    "prepare": "npm run compile",
    "commit": "node out/cli.js",
    "test": "npm run compile && node --test test/changes.test.js test/message.test.js test/git.test.js test/cli.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.9.2"
  }
}
